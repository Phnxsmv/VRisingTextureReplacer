<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>VRisingTextureReplacer</AssemblyName>
    <Product>My first plugin</Product>
    <Version>1.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>VRisingTextureReplacer</RootNamespace>
  </PropertyGroup>
  <Target Name="DeployToGame" AfterTargets="Build">
  <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="F:\Games\Steam\steamapps\common\VRising\BepInEx\plugins" />
  </Target>
  <ItemGroup>
    <PackageReference Include="HarmonyX" Version="2.16.1" />
    <PackageReference Include="VRising.UnhollowedX.Client" Version="1.0.11" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="BepInEx.Core">
      <HintPath>F:\Games\Steam\steamapps\common\VRising\BepInEx\core\BepInEx.Core.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>F:\Games\Steam\steamapps\common\VRising\BepInEx\core\BepInEx.Unity.IL2CPP.dll</HintPath>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>F:\Games\Steam\steamapps\common\VRising\BepInEx\core\Il2CppInterop.Runtime.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
